[Unit]
Description=AMS Sensors Dashboard
After=network.target

[Service]
Type=simple
User=ams-root
WorkingDirectory=/home/ams-root/AMS_SW
ExecStart=/home/ams-root/AMS_SW/init.sh --daemon
Restart=always
RestartSec=10

# Отключаем запись логов на SD-карту (journald)
# Вывод остаётся только в tmux-панелях (в оперативной памяти)
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
