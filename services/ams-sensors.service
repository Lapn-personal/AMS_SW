[Unit]
Description=AMS Sensors Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ams-root/AMS_SW
ExecStart=/home/ams-root/AMS_SW/init.sh --daemon
Restart=always
RestartSec=10

# Включаем запись логов в journald для отладки
# После отладки можно вернуть null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
